# EchoLog AI Engine — Environment Variables
# Copy this file to .env and fill in your values.
# If AWS credentials are not provided, the engine runs in mock mode automatically.

# ─── AWS Bedrock Credentials ───────────────────────────────────────────────
# Required for live inference. If absent, deterministic mock mode activates.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ─── Model Selection ────────────────────────────────────────────────────────
# Claude 3.5 Sonnet (recommended) — requires Bedrock model access in your AWS account
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Alternative models:
# BEDROCK_MODEL_ID=amazon.titan-text-premier-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ─── Service URLs ───────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:8080
