{
  "name": "echolog",
  "displayName": "EchoLog — Live DevEx Intelligence",
  "description": "Captures real-world verbal technical conversations and injects architectural summaries directly into your VS Code workspace.",
  "version": "1.0.0",
  "publisher": "echolog-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "architecture",
    "devex",
    "decisions",
    "bedrock",
    "wearable"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "echolog.exportDecisions",
        "title": "EchoLog: Export Decisions to Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "echolog.connectGateway",
        "title": "EchoLog: Connect to Gateway",
        "icon": "$(plug)"
      },
      {
        "command": "echolog.disconnectGateway",
        "title": "EchoLog: Disconnect from Gateway",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "echolog.clearDecisions",
        "title": "EchoLog: Clear All Decisions",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "echolog-sidebar",
          "title": "EchoLog",
          "icon": "media/echolog-icon.svg"
        }
      ]
    },
    "views": {
      "echolog-sidebar": [
        {
          "type": "webview",
          "id": "echolog.panel",
          "name": "Live Decisions",
          "icon": "media/echolog-icon.svg",
          "contextualTitle": "EchoLog Panel"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "echolog.exportDecisions",
          "when": "view == echolog.panel",
          "group": "navigation"
        },
        {
          "command": "echolog.clearDecisions",
          "when": "view == echolog.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "EchoLog",
      "properties": {
        "echolog.gatewayUrl": {
          "type": "string",
          "default": "ws://localhost:8081",
          "description": "WebSocket URL of the EchoLog Event Gateway"
        },
        "echolog.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the gateway on startup"
        },
        "echolog.showInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline phantom text decorations when a relevant file is open"
        },
        "echolog.maxDecisions": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of decisions to keep in memory per session"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "ts-loader": "^9.5.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "@types/ws": "^8.5.10"
  }
}
